{
  "name": "appjaci",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "server": "npm --prefix server run start",
    "server:dev": "npm --prefix server run dev",
    "install:all": "npm ci && npm --prefix server ci",
    "db:setup": "npm --prefix server run db:setup",
    "demo:server": "npm --prefix server run start",
    "demo:web": "expo start --web --clear",
    "format": "prettier --write app src server/src server/testes server/painel docs server/*.json compose.yaml *.json *.js *.md",
    "format:check": "prettier --check app src server/src server/testes server/painel docs server/*.json compose.yaml *.json *.js *.md",
    "typecheck": "tsc --noEmit && npm --prefix server run typecheck",
    "test": "npm --prefix server test",
    "test:integration": "npm --prefix server run test:integration"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.102.8",
    "axios": "^1.20.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.36",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-constants": "~18.0.14",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-video": "~3.0.16",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.87.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "^13.15.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "private": true,
  "devDependencies": {
    "@types/react": "~19.1.10",
    "prettier": "^3.9.9",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "postcss": "^8.5.28"
  }
}
